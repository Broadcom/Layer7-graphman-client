      "categories": [
        "TRAFFIC",
        "LOG"
      ],
      "syslogHosts": [
        "127.0.0.1:8789"
      ],
      "filters": [
        {
          "type": "listen-port",
          "values": [
            "Default HTTPS (9443)"
          ]
        }
